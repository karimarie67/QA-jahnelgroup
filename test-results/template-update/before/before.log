    [31m          const d = (g.cy - mid) / vh;                  // >0 → still below the midline[39m
    [31m          const n = Math.min(1, Math.abs(d) / (d >= 0 ? RISE : FALL));[39m
    [31m          const k = 1 - n;[39m
