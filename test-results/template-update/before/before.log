    [31m}[39m
    [31m.vid-modal.is-open { opacity: 1; pointer-events: all; }[39m
    [31m.vid-modal__container { position: relative; width: min(920px, 90vw); aspect-ratio: 16/9; }[39m
    [31m.vid-modal__close {[39m
    [31m  position: absolute; top: -48px; right: 0;[39m
    [31m  background: none; border: 1px solid rgba(244,244,244,0.2); color: #F4F4F4;[39m
    [31m  font-size: 16px; width: 40px; height: 40px; cursor: pointer;[39m
    [31m  display: flex; align-items: center; justify-content: center;[39m
    [31m  transition: border-color 0.2s, color 0.2s; line-height: 1;[39m
    [31m  font-family: 'Libre Franklin', sans-serif;[39m
    [31m}[39m
    [31m.vid-modal__close:hover { border-color: #00BDFF; color: #00BDFF; }[39m
    [31m.vid-modal__frame { width: 100%; height: 100%; border: none; display: block; }[39m
    [31m[39m
    [31m/* ──────────────────────────────────────────────────────────────[39m
    [31m   08 — CONTACT[39m
    [31m   ────────────────────────────────────────────────────────────── */[39m
    [31m.hr-contact {[39m
    [31m  background: #0d1012;[39m
    [31m  padding: clamp(72px, 9vw, 124px) 0;[39m
    [31m}[39m
    [31m/* Single column: headline above, form below at full wrap width. Was 9fr/11fr[39m
    [31m   side-by-side — the form only fits three fields to a row now that it has the[39m
    [31m   whole width. Mobile already stacked, so nothing changes there. */[39m
    [31m.hr-contact__inner {[39m
    [31m  display: grid;[39m
    [31m  grid-template-columns: 1fr;[39m
    [31m  gap: clamp(36px, 4vw, 60px);[39m
    [31m  align-items: start;[39m
    [31m}[39m
    [31m.hr-contact__h2 {[39m
    [31m  font-family: 'Anton', sans-serif;[39m
    [31m  font-weight: 400;[39m
    [31m  font-size: clamp(32px, 4vw, 54px);[39m
    [31m  line-height: 0.98;[39m
    [31m  text-transform: uppercase;[39m
    [31m  color: #F4F4F4;[39m
    [31m  margin: 0 0 22px;[39m
    [31m}[39m
    [31m.hr-contact__h2 em { color: #00BDFF; font-style: normal; }[39m
    [31m.hr-contact__sub {[39m
    [31m  font-family: 'Libre Franklin', sans-serif;[39m
    [31m  font-weight: 300;[39m
    [31m  line-height: 1.8;[39m
    [31m  color: #B0B2B5;[39m
    [31m  /* 38ch when this sat in the narrow left column; under a full-width headline[39m
    [31m     that read as an orphaned skinny paragraph. Still capped for readability —[39m
    [31m     66ch fits the current intro on one line (it needs 65ch; 62 orphaned[39m
    [31m     \"to go.\" onto its own line). */[39m
    [31m  max-width: 66ch;[39m
    [31m  margin: 0;[39m
    [31m}[39m
    [31m[39m
    [31m/* Form-field primitives now live in css/contact-form.css (shared with[39m
    [31m   contact.html's form, one definition for both). What stays here is layout[39m
    [31m   this page alone needs, because its form runs full width. */[39m
    [31m[39m
    [31m/* Three to a row. Set as a variable rather than an inline style so the[39m
    [31m   breakpoints below can still win — an inline `--cols` would outrank them.[39m
    [31m   (The captcha/submit row is .con-form-actions in css/contact-form.css —[39m
    [31m   shared, since the contact page uses the same arrangement.) */[39m
    [31m.hr-form-row--3 { --cols: 3; }[39m
    [31m[39m
    [31m/* ──────────────────────────────────────────────────────────────[39m
    [31m   RESPONSIVE[39m
    [31m   ────────────────────────────────────────────────────────────── */[39m
    [31m@media (max-width: 880px) {[39m
    [31m  .hr-cap__inner { grid-template-columns: 1fr; }[39m
    [31m  /* Three narrow fields don't fit a tablet — drop to two. Below 600px the[39m
    [31m     shared contact-form.css collapses every row to one. */[39m
    [31m  .hr-form-row--3 { --cols: 2; }[39m
    [31m  /* Company is the odd one out in a 2-col grid; left alone it sat at half[39m
    [31m     width with dead space beside it. Span the row instead. */[39m
    [31m  .hr-form-row--3 > .con-field:last-child { grid-column: 1 / -1; }[39m
    [31m  .hr-cap__left { position: static; }[39m
    [31m  /* The plug-in vignette is a two-column device: it reads as the left rail's[39m
    [31m     companion to the capability stack. Once the grid collapses it's just an[39m
    [31m     animation sitting between the copy and the cards, so it goes away — and[39m
    [31m     its 5s timeline stops running on phones. */[39m
    [31m  .hr-cap__anim { display: none; }[39m
    [31m  .hr-awards__grid { grid-template-columns: 1fr; }[39m
    [31m  .hr-awards__rings {[39m
    [31m    flex-direction: row;[39m
    [31m    justify-content: center;[39m
    [31m    gap: clamp(24px, 6vw, 64px);[39m
    [31m    border-left: none;[39m
    [31m    border-right: none;[39m
    [31m    border-top: 1px solid rgba(244,244,244,0.1);[39m
    [31m    border-bottom: 1px solid rgba(244,244,244,0.1);[39m
    [31m  }[39m
    [31m  .hr-culture__inner { grid-template-columns: 1fr; }[39m
    [31m  .hr-hero__actions { flex-direction: column; align-items: flex-start; }[39m
    [31m}[39m
    [31m@media (max-width: 640px) {[39m
    [31m  .hr-awards__rings { flex-direction: column; }[39m
    [31m  .hr-ring { width: clamp(190px, 56vw, 240px); }[39m
    [31m}[39m
