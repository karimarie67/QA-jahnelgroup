    [31m}[39m
    [31m.hr-cap__stack {[39m
    [31m  display: grid;[39m
    [31m  grid-template-columns: 1fr;[39m
    [31m  gap: 1px;[39m
    [31m  background: rgba(244,244,244,0.1);[39m
