    [31m  77.5%, 100% { clip-path: inset(0 100% 0 0); } /* stay painted through the CRT collapse */[39m
    [31m}[39m
    [31m@keyframes cx-l3 {[39m
    [31m  0%, 46%     { clip-path: inset(0 100% 0 0); animation-timing-function: steps(11, end); }[39m
    [31m  50%, 73.9%  { clip-path: inset(0 0 0 0); animation-timing-function: steps(1, end); }[39m
    [31m  77.5%, 100% { clip-path: inset(0 100% 0 0); } /* stay painted through the CRT collapse */[39m
    [31m}[39m
    [31m@keyframes cx-l4 {[39m
    [31m  0%, 52%     { clip-path: inset(0 100% 0 0); animation-timing-function: steps(19, end); }[39m
    [31m  60%, 73.9%  { clip-path: inset(0 0 0 0); animation-timing-function: steps(1, end); }[39m
    [31m  77.5%, 100% { clip-path: inset(0 100% 0 0); } /* stay painted through the CRT collapse */[39m
    [31m}[39m
