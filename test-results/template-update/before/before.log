    [31m.hr-cap__card:hover .hr-cap__arrow { transform: translateY(-50%) translateX(4px); }[39m
    [31m.hr-cap__arrow svg {[39m
    [31m  width: 20px;[39m
    [31m  height: 20px;[39m
