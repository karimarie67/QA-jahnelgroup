    [31m}[39m
    [31m.hr-cap__card-h3 {[39m
    [31m  font-family: 'Anton', sans-serif;[39m
    [31m  font-weight: 400;[39m
    [31m  font-size: clamp(24px, 2.7vw, 38px);[39m
    [31m  line-height: 1;[39m
