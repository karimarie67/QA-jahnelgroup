    [31m[39m
    [31m/* ── Plug-in / code / unplug vignette — one shared 5s timeline ──[39m
    [31m   Scene beats as keyframe percentages: plug in ~6-16%, power on[39m
    [31m   ~18-24%, typing ~24-60%, yank out ~70-78%, screen dies at 74%. */[39m
    [31m.hr-cap__anim {[39m
    [31m  margin-top: clamp(40px, 5vw, 64px);[39m
    [31m  max-width: 460px;[39m
    [31m}[39m
    [31m.hr-cap__anim svg { display: block; width: 100%; height: auto; }[39m
    [31m[39m
    [31m.cx-body   { fill: #161719; stroke: rgba(244,244,244,0.75); stroke-width: 2; }[39m
    [31m/* Outer glow around the monitor while powered — same beats as cx-glow:[39m
    [31m   ramps in with power-on (18-24%), dies with the screen at 74%.[39m
    [31m   A pre-blurred rect behind the body animating OPACITY only — never[39m
    [31m   animate the filter itself (it re-renders the blur every frame). */[39m
    [31m.cx-halo {[39m
    [31m  fill: none;[39m
    [31m  stroke: rgba(0,189,255,0.6);[39m
    [31m  stroke-width: 5;[39m
    [31m  filter: blur(9px);[39m
    [31m  opacity: 0;[39m
    [31m  animation: cx-halo 5s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-halo {[39m
    [31m  0%, 18%    { opacity: 0; }[39m
    [31m  24%, 73.9% { opacity: 1; }[39m
    [31m  74%, 100%  { opacity: 0; }[39m
    [31m}[39m
    [31m.cx-screen { fill: none; stroke: rgba(244,244,244,0.25); stroke-width: 1.5; }[39m
    [31m.cx-stand  { stroke: rgba(244,244,244,0.5); stroke-width: 2; stroke-linecap: round; }[39m
    [31m.cx-wall   { stroke: rgba(244,244,244,0.35); stroke-width: 2; stroke-linecap: round; }[39m
    [31m.cx-outlet { fill: #161719; stroke: rgba(244,244,244,0.6); stroke-width: 2; }[39m
    [31m.cx-cord   { stroke: rgba(244,244,244,0.45); stroke-width: 2; stroke-linecap: round; fill: none; }[39m
    [31m.cx-plug-body { fill: #161719; stroke: rgba(244,244,244,0.7); stroke-width: 2; }[39m
    [31m.cx-prongs { stroke: rgba(244,244,244,0.7); stroke-width: 2; stroke-linecap: round; }[39m
    [31m[39m
    [31m.cx-plug-group { animation: cx-plug 5s infinite; }[39m
    [31m@keyframes cx-plug {[39m
    [31m  0%, 6%    { transform: translateX(0);    animation-timing-function: cubic-bezier(0.3, 0.7, 0.3, 1); }[39m
    [31m  16%, 70%  { transform: translateX(16px); animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4); }[39m
    [31m  78%, 100% { transform: translateX(0); }[39m
    [31m}[39m
    [31m/* Cord is anchored at the monitor (origin = its hidden start point) and[39m
    [31m   stretches taut as the plug travels: end lands exactly 16px right[39m
    [31m   (scaleX 96/80), sag lifts a touch (scaleY). Same beats as cx-plug.[39m
    [31m   vector-effect=\"non-scaling-stroke\" keeps the stroke width constant. */[39m
    [31m.cx-cord {[39m
    [31m  transform-box: view-box;[39m
    [31m  transform-origin: 170px 136px;[39m
    [31m  animation: cx-cord-flex 5s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-cord-flex {[39m
    [31m  0%, 6%    { transform: scale(1, 1);          animation-timing-function: cubic-bezier(0.3, 0.7, 0.3, 1); }[39m
    [31m  16%, 70%  { transform: scale(1.2, 0.88); animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.4); }[39m
    [31m  78%, 100% { transform: scale(1, 1); }[39m
    [31m}[39m
    [31m.cx-spark {[39m
    [31m  fill: none;[39m
    [31m  stroke: #00BDFF;[39m
    [31m  stroke-width: 2;[39m
    [31m  opacity: 0;[39m
    [31m  transform-box: fill-box;[39m
    [31m  transform-origin: center;[39m
    [31m  animation: cx-spark 5s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-spark {[39m
    [31m  0%, 15%   { opacity: 0; transform: scale(0.4); }[39m
    [31m  18%       { opacity: 1; transform: scale(1); }[39m
    [31m  25%, 100% { opacity: 0; transform: scale(1.7); }[39m
    [31m}[39m
    [31m.cx-led {[39m
    [31m  fill: rgba(244,244,244,0.25);[39m
    [31m  animation: cx-led 5s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-led {[39m
    [31m  0%, 17%    { fill: rgba(244,244,244,0.25); }[39m
    [31m  18%, 73.9% { fill: #00BDFF; }[39m
    [31m  74%, 100%  { fill: rgba(244,244,244,0.25); }[39m
    [31m}[39m
    [31m.cx-glow {[39m
    [31m  fill: #00BDFF;[39m
    [31m  opacity: 0;[39m
    [31m  animation: cx-glow 5s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-glow {[39m
    [31m  0%, 18%    { opacity: 0; }[39m
    [31m  24%, 73.9% { opacity: 0.07; }[39m
    [31m  74.6%      { opacity: 0.55; } /* flash bright as it squishes into the CRT line */[39m
    [31m  77.5%, 100% { opacity: 0; }[39m
    [31m}[39m
    [31m/* CRT power-off — on unplug the screen content collapses vertically to a[39m
    [31m   bright center line (edges die first, middle lingers), then the line[39m
    [31m   snaps to a dot and fades. Whole thing ~175ms: 74% -> 77.5% of 5s. */[39m
    [31m.cx-crt {[39m
    [31m  transform-box: view-box;[39m
    [31m  transform-origin: 120px 84px; /* screen center */[39m
    [31m  animation: cx-crt-off 5s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-crt-off {[39m
    [31m  0%, 74%     { transform: scale(1, 1);       opacity: 1; animation-timing-function: cubic-bezier(0.8, 0, 1, 0.6); }[39m
    [31m  76.5%       { transform: scale(1, 0.03);    opacity: 1; }[39m
    [31m  77.5%, 100% { transform: scale(0.12, 0.03); opacity: 0; }[39m
    [31m}[39m
    [31m/* Typed code — clip-path reveals left-to-right; steps() count matches[39m
    [31m   each line's character count so every step uncovers one mono char. */[39m
    [31m.cx-code {[39m
    [31m  font-family: 'JetBrains Mono', monospace;[39m
    [31m  font-size: 9px;[39m
    [31m  fill: rgba(244,244,244,0.55);[39m
    [31m  clip-path: inset(0 100% 0 0);[39m
    [31m}[39m
    [31m.cx-kw { fill: rgba(0,189,255,0.85); }[39m
    [31m.cx-code--comment { fill: rgba(244,244,244,0.32); }[39m
    [31m.cx-code--1 { animation: cx-l1 5s infinite; }[39m
    [31m.cx-code--2 { animation: cx-l2 5s infinite; }[39m
    [31m.cx-code--3 { animation: cx-l3 5s infinite; }[39m
    [31m.cx-code--4 { animation: cx-l4 5s infinite; }[39m
    [31m@keyframes cx-l1 {[39m
    [31m  0%, 24%     { clip-path: inset(0 100% 0 0); animation-timing-function: steps(26, end); }[39m
    [31m  34%, 73.9%  { clip-path: inset(0 0 0 0); animation-timing-function: steps(1, end); }[39m
    [31m  77.5%, 100% { clip-path: inset(0 100% 0 0); } /* stay painted through the CRT collapse */[39m
    [31m}[39m
    [31m@keyframes cx-l2 {[39m
    [31m  0%, 36%     { clip-path: inset(0 100% 0 0); animation-timing-function: steps(21, end); }[39m
    [31m  44%, 73.9%  { clip-path: inset(0 0 0 0); animation-timing-function: steps(1, end); }[39m
    [31m  77.5%, 100% { clip-path: inset(0 100% 0 0); } /* stay painted through the CRT collapse */[39m
    [31m}[39m
    [31m@keyframes cx-l3 {[39m
    [31m  0%, 46%     { clip-path: inset(0 100% 0 0); animation-timing-function: steps(11, end); }[39m
    [31m  50%, 73.9%  { clip-path: inset(0 0 0 0); animation-timing-function: steps(1, end); }[39m
    [31m  77.5%, 100% { clip-path: inset(0 100% 0 0); } /* stay painted through the CRT collapse */[39m
    [31m}[39m
    [31m@keyframes cx-l4 {[39m
    [31m  0%, 52%     { clip-path: inset(0 100% 0 0); animation-timing-function: steps(19, end); }[39m
    [31m  60%, 73.9%  { clip-path: inset(0 0 0 0); animation-timing-function: steps(1, end); }[39m
    [31m  77.5%, 100% { clip-path: inset(0 100% 0 0); } /* stay painted through the CRT collapse */[39m
    [31m}[39m
    [31m.cx-caret-gate {[39m
    [31m  opacity: 0;[39m
    [31m  animation: cx-caret-gate 5s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-caret-gate {[39m
    [31m  0%, 21%    { opacity: 0; }[39m
    [31m  22%, 73.9% { opacity: 1; }[39m
    [31m  74%, 100%  { opacity: 0; }[39m
    [31m}[39m
    [31m.cx-caret {[39m
    [31m  fill: #00BDFF;[39m
    [31m  animation: cx-caret-blink 1s infinite;[39m
    [31m}[39m
    [31m@keyframes cx-caret-blink {[39m
    [31m  0%, 49%   { opacity: 1; }[39m
    [31m  50%, 100% { opacity: 0; }[39m
    [31m}[39m
    [31m[39m
    [31m@media (prefers-reduced-motion: reduce) {[39m
    [31m  .hr-cap__arrow svg,[39m
    [31m  .hr-arrow::after,[39m
    [31m  .hr-cap__arrow { transition: none; }[39m
    [31m  .hr-cap__card .hr-cap__card-head,[39m
    [31m  .hr-cap__card .hr-cap__card-body { opacity: 1; transform: none; transition: none; }[39m
    [31m  /* Vignette freezes on the \"plugged in, code written\" frame */[39m
    [31m  .hr-cap__anim * { animation: none; }[39m
    [31m  .cx-plug-group { transform: translateX(16px); }[39m
    [31m  .cx-cord { transform: scale(1.2, 0.88); }[39m
    [31m  .cx-code { clip-path: none; }[39m
    [31m  .cx-glow { opacity: 0.07; }[39m
    [31m  .cx-led { fill: #00BDFF; }[39m
