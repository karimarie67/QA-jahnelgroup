    [31m          slot.style.transform = '';[39m
    [31m          const r = slot.getBoundingClientRect();[39m
    [31m          return { slot, cy: r.top + window.scrollY + r.height / 2 };[39m
    [31m        });[39m
    [31m      }[39m
    [31m      function swell() {[39m
    [31m        if (NARROW.matches) { for (const g of geo) g.slot.style.transform = ''; return; }[39m
    [31m        const vh = window.innerHeight, mid = window.scrollY + vh / 2;[39m
