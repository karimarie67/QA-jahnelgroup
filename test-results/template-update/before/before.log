    [31m.mapx-stage {[39m
    [31m  position: relative;[39m
    [31m  display: grid;[39m
    [31m  /* Cards overlay the map — single track. minmax(0,1fr), not bare 1fr:[39m
    [31m     the canvas's fixed px width must not lock the track's min size on[39m
    [31m     shrink (resize desktop->mobile would deadlock at the old width). */[39m
