    [31m.hr-cap__h2 em { color: #00BDFF; font-style: normal; }[39m
    [31m.hr-cap__sub {[39m
    [31m  font-family: 'Libre Franklin', sans-serif;[39m
    [31m  font-weight: 300;[39m
    [31m  line-height: 1.7;[39m
    [31m  color: #B0B2B5;[39m
