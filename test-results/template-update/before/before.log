    [31m/* Cards ride the shared .reveal/.in observer (js/main.js) but must stay[39m
    [31m   opaque themselves — a transparent card exposes the hairline-grid[39m
    [31m   background as a gray slab. Only the inner content animates. */[39m
    [31m.hr-cap__card.reveal {[39m
    [31m  opacity: 1;[39m
