    [31m}[39m
    [31m[39m
    [31m/* ── Mobile: the same poster, scaled down ──[39m
    [31m   Same orientation as desktop — headline in the Atlantic, stats in the[39m
    [31m   Pacific, cards parked over open ocean with their arcs running back to[39m
    [31m   the pins. Everything on the map is sized off --map-w so it stays one[39m
    [31m   picture at any width; nothing here may be a fixed px value.[39m
    [31m   The cards are the exception that can't scale — their copy has a[39m
    [31m   readability floor — so they ride wider than desktop's 23% and their[39m
    [31m   slots move out to the edges to keep the continent clear. */[39m
    [31m@media (max-width: 880px) {[39m
    [31m  /* The photo is what forces the card wide. Without it the card is a[39m
    [31m     callout chip that annotates the map instead of covering it. */[39m
    [31m  .mapx-photo { display: none; }[39m
    [31m  /* The mono line repeats the city line — one of them has to go when the[39m
    [31m     card is this small, and the city line is the one carrying the flag. */[39m
    [31m  .mapx-meta { display: none; }[39m
    [31m  /* Wide enough that no location line wraps — a wrapped chip grows tall[39m
    [31m     and starts colliding with the pins it's pointing at. */[39m
    [31m  /* Capped in px as well as %: the chip's copy doesn't scale, so past[39m
    [31m     ~570px of map a % width just adds empty card around fixed type. */[39m
    [31m  .mapx-slot { width: 44%; min-width: 132px; max-width: 250px; }[39m
    [31m  .mapx-slot[data-loc=\"hq\"] { left: 1%;  top: 13%; }[39m
    [31m  /* 42% is where it wants to sit. But the chip's height is fixed while the[39m
    [31m     map scales, so on the smallest phones 42% puts it on top of the São[39m
    [31m     Paulo pin (at 69% of map height) — the second term backs it off to[39m
    [31m     clear the pin by the chip's own height plus a gap. No breakpoint step:[39m
    [31m     whichever constraint binds, wins. */[39m
    [31m  .mapx-slot[data-loc=\"sp\"] { left: 52%; top: min(42%, calc(69% - 108px)); }[39m
    [31m  .mapx-card { padding: 0.55rem 0.6rem 0.6rem; }[39m
    [31m  .mapx-who   { font-size: 0.8rem; line-height: 1.15; }[39m
    [31m  .mapx-where { font-size: 0.7rem; line-height: 1.4; margin-top: 0.35rem; }[39m
    [31m  /* Pin dot + ping rings: fractions tuned so the pin reads the same at[39m
    [31m     360px as at 880px (0.024 ≈ the desktop 10px dot on a ~420px map). */[39m
    [31m  .mapx-dot {[39m
    [31m    width:  calc(var(--map-w, 400px) * 0.024);[39m
    [31m    height: calc(var(--map-w, 400px) * 0.024);[39m
