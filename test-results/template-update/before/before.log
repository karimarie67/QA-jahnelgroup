    [31m/* ──────────────────────────────────────────────────────────────[39m
    [31m   03 — LOGO GARDEN[39m
    [31m   ────────────────────────────────────────────────────────────── */[39m
    [31m.hr-logos {[39m
    [31m  background: #161719;[39m
    [31m  padding: clamp(52px, 6vw, 80px) 0;[39m
    [31m  border-top: 1px solid rgba(244,244,244,0.06);[39m
    [31m  overflow: hidden;[39m
    [31m}[39m
    [31m.hr-logos__label {[39m
    [31m  display: flex;[39m
    [31m  align-items: center;[39m
    [31m  gap: 22px;[39m
    [31m  font-family: 'JetBrains Mono', monospace;[39m
    [31m  font-size: 11px;[39m
    [31m  letter-spacing: 0.18em;[39m
    [31m  text-transform: uppercase;[39m
    [31m  color: #F4F4F4;[39m
    [31m  margin: 0 0 44px;[39m
    [31m  white-space: nowrap;[39m
    [31m}[39m
    [31m/* Hairlines run to both edges from the centered label */[39m
    [31m.hr-logos__label::before,[39m
    [31m.hr-logos__label::after {[39m
    [31m  content: \"\";[39m
    [31m  height: 1px;[39m
    [31m  flex: 1;[39m
    [31m  background: rgba(244,244,244,0.08);[39m
    [31m}[39m
    [31m/* The line is 44 characters of tracked-out mono — wider than a phone. With[39m
    [31m   nowrap it ran straight off the right edge and the section's overflow:hidden[39m
    [31m   ate the last word. Let it wrap and drop the hairlines, which have no room[39m
    [31m   to read at this width anyway. */[39m
    [31m@media (max-width: 620px) {[39m
    [31m  .hr-logos__label {[39m
    [31m    display: block;[39m
    [31m    white-space: normal;[39m
    [31m    text-align: center;[39m
    [31m    line-height: 1.7;[39m
    [31m  }[39m
    [31m  .hr-logos__label::before,[39m
    [31m  .hr-logos__label::after { display: none; }[39m
    [31m}[39m
    [31m/* ── Marquee: one slow, seamless, full-bleed row; logos fade in and[39m
    [31m   out through gradient masks at the edges. JS duplicates the cells[39m
    [31m   once so translateX(-50%) loops with no seam. Hover pauses. ── */[39m
    [31m.trust-mask {[39m
    [31m  overflow: hidden;[39m
    [31m  /* Vertical breathing room so a hovered logo's scale-up spills past the[39m
    [31m     row instead of being clipped by overflow; negative margin cancels it[39m
    [31m     so the section's rhythm is unchanged. */[39m
    [31m  padding: 14px 0;[39m
    [31m  margin: -14px 0;[39m
    [31m  -webkit-mask: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);[39m
    [31m          mask: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);[39m
    [31m}[39m
    [31m.hr-logos #trust {[39m
    [31m  display: flex;[39m
    [31m  width: max-content;[39m
    [31m  align-items: center;[39m
    [31m  border: none;[39m
    [31m  animation: hr-logo-scroll 46s linear infinite;[39m
    [31m}[39m
    [31m.hr-logos #trust:hover { animation-play-state: paused; }[39m
    [31m@keyframes hr-logo-scroll {[39m
    [31m  to { transform: translateX(-50%); }[39m
    [31m}[39m
    [31m.hr-logos #trust .cell {[39m
    [31m  aspect-ratio: auto;[39m
    [31m  padding: 0;[39m
    [31m  border: none;[39m
    [31m  flex: none;[39m
    [31m  /* spacing via margin (not flex gap) so each duplicated half is EXACTLY[39m
    [31m     50% of the track — the -50% wrap then lands seamlessly */[39m
    [31m  margin-right: clamp(56px, 7vw, 104px);[39m
    [31m}[39m
    [31m.hr-logos #trust .cell:hover { background: none; box-shadow: none; }[39m
    [31m.hr-logos #trust img {[39m
    [31m  max-height: 88px;[39m
    [31m  max-width: 300px;[39m
    [31m  opacity: 0.72;[39m
    [31m  filter: saturate(0.85);[39m
    [31m}[39m
    [31m.hr-logos #trust .cell:hover img {[39m
    [31m  opacity: 1;[39m
    [31m  transform: scale(1.1);[39m
    [31m  filter: brightness(1.15) saturate(1.05);[39m
    [31m}[39m
