    [31m.hr-cap__card {[39m
    [31m  /* flex + centered: the stack's rows stretch taller than the content, so[39m
    [31m     without this the text pins to the top and the card bottom sits empty */[39m
    [31m  display: flex;[39m
    [31m  flex-direction: column;[39m
    [31m  justify-content: center;[39m
    [31m  position: relative;   /* the arrow centers against the card, not the head */[39m
    [31m  background: #161719;[39m
    [31m  padding: clamp(38px, 4.4vw, 58px) clamp(28px, 3.2vw, 46px);[39m
    [31m  border: 1px solid transparent;[39m
    [31m  text-decoration: none;[39m
    [31m  cursor: pointer;[39m
