    [31m  transition: background 0.25s, border-color 0.25s;[39m
    [31m}[39m
    [31m.hr-cap__card .hr-cap__card-head,[39m
    [31m.hr-cap__card .hr-cap__card-body {[39m
    [31m  opacity: 0;[39m
    [31m  transform: translateY(22px);[39m
    [31m  transition: opacity 0.65s ease, transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);[39m
    [31m}[39m
    [31m.hr-cap__card .hr-cap__card-body { transition-delay: 0.08s; }[39m
    [31m/* the arrow is a direct card child (NOT inside the transformed head — a[39m
    [31m   transformed ancestor would hijack its absolute positioning), so it[39m
    [31m   reveals with opacity only */[39m
    [31m.hr-cap__card .hr-cap__arrow { opacity: 0; transition: opacity 0.65s ease 0.08s, transform 0.25s; }[39m
    [31m.hr-cap__card.in .hr-cap__card-head,[39m
    [31m.hr-cap__card.in .hr-cap__card-body { opacity: 1; transform: none; }[39m
    [31m.hr-cap__card.in .hr-cap__arrow { opacity: 1; }[39m
    [31m.hr-cap__card:hover {[39m
    [31m  background: rgba(0,189,255,0.05);[39m
